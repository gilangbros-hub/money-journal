{
  "name": "login-app",
  "version": "1.0.0",
  "description": "Money Journal App",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "dev:css": "npx tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "dev": "node app.js",
    "test": "npm run test:acceptance",
    "test:unit": "node scripts/run-test-phase.js unit",
    "test:property": "node scripts/run-test-phase.js property",
    "test:integration": "node scripts/run-test-phase.js integration",
    "test:ui": "node scripts/run-test-phase.js ui",
    "test:migration": "node scripts/run-test-phase.js migration",
    "test:concurrency": "node scripts/run-test-phase.js concurrency",
    "test:feature": "node --test test/rolloutCompatibility.test.js",
    "test:acceptance": "node scripts/run-acceptance-profile.js",
    "test:all": "npm run test:acceptance",
    "rollout:preflight": "node scripts/rollout-preflight.js",
    "rollout:verify": "node scripts/rollout-verify.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "connect-mongo": "4.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "mongoose": "^8.0.0",
    "resend": "^6.9.1"
  },
  "devDependencies": {
    "fast-check": "^4.10.1",
    "jsdom": "^24.1.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  }
}
