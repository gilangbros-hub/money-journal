<!-- Bottom navigation: the one primary nav across the app's tab pages.
     The spacer keeps the last content clear of the fixed bar and the + button. -->
<div class="bottom-navbar-spacer" aria-hidden="true"></div>
<nav class="bottom-navbar" aria-label="Main">
    <a href="/monthly-story" class="nav-item {{#if isDashboard}}active{{/if}}" {{#if isDashboard}}aria-current="page"{{/if}}>
        <span class="material-symbols-outlined" aria-hidden="true">insights</span>
        <span class="nav-item-label">Story</span>
    </a>
    <a href="/review-history" class="nav-item {{#if isHistory}}active{{/if}}" {{#if isHistory}}aria-current="page"{{/if}}>
        <span class="material-symbols-outlined" aria-hidden="true">history</span>
        <span class="nav-item-label">History</span>
    </a>
    <a href="/check-pockets" class="nav-item {{#if isBudget}}active{{/if}}" {{#if isBudget}}aria-current="page"{{/if}}>
        <span class="material-symbols-outlined" aria-hidden="true">account_balance_wallet</span>
        <span class="nav-item-label">Pockets</span>
    </a>
</nav>
