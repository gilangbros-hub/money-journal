<!DOCTYPE html>
<html lang="en">

<head>
    {{> head}}
    <title>Log Spending</title>
</head>

<body class="transaction-screen">
    <div class="page-container transaction-layout">
        <header class="app-header">
            <div>
                <p class="journal-eyebrow"><a href="/monthly-story" id="backLink" style="color: inherit; text-decoration: none;">← Back</a></p>
                <h1 class="page-title page-title-ledger transaction-title">Log Spending <span class="inline-flex items-center gap-1 bg-gradient-danger text-white py-1 px-3 rounded-full text-xs font-bold ml-2 align-middle" id="streakBadge" style="display:none;"></span></h1>
            </div>
            <div class="user-info" onclick="toggleMenu()">
                <span class="text-sm font-semibold text-text-secondary">{{username}}</span>
                <span class="text-[28px]">{{avatar}}</span>
            </div>
            <div id="userMenu" class="user-menu">
                <a href="/profile">Edit Profile</a>
                <a href="/logout" class="logout">Logout</a>
            </div>
        </header>

        <input type="hidden" id="currentUsername" value="{{username}}">

        <form id="transactionForm">
            <input type="hidden" id="transactionId" name="transactionId">

            <div class="transaction-shell">
                <section class="transaction-counter">
                    <p class="transaction-counter-label">Amount</p>
                    <p class="transaction-counter-currency">Rp</p>
                    <input type="text" inputmode="numeric" autocomplete="off" id="amount" name="amount" placeholder="0" required class="transaction-counter-input" aria-label="Amount in rupiah">
                    <button type="button" class="transaction-amount-quick" id="amountThousandsBtn" aria-label="Add three zeros">000</button>
                </section>

                <section class="transaction-section">
                    <label class="transaction-field-label" for="ngapain">Note</label>
                    <input type="text" id="ngapain" name="ngapain" placeholder="Note (optional)" class="transaction-note-input">
                </section>

                <section class="transaction-section transaction-rows">
                    <button type="button" class="transaction-row" id="categoryTrigger">
                        <span class="transaction-row-label">Category</span>
                        <span class="transaction-row-value" id="selectedTypeDisplay">Eat</span>
                    </button>

                    <!-- Kept for the form state; switched by #splitToggle below. -->
                    <div class="transaction-mode-toggle" hidden>
                        <label class="transaction-mode-pill">
                            <input type="radio" name="sourceType" value="single" checked id="sourceTypeSingle">
                            <span>Single Pocket</span>
                        </label>
                        <label class="transaction-mode-pill">
                            <input type="radio" name="sourceType" value="multi" id="sourceTypeMulti">
                            <span>Multi Pocket</span>
                        </label>
                    </div>

                    <button type="button" class="transaction-row" id="pocketTrigger">
                        <span class="transaction-row-label">Pocket</span>
                        <span class="transaction-row-value" id="selectedPocketDisplay">Loading…</span>
                    </button>

                    <button type="button" class="transaction-split-link" id="splitToggle" aria-controls="multiPocketSection">Split across pockets</button>

                    <div class="transaction-breakdown-panel" id="multiPocketSection" style="display:none;">
                        <div class="transaction-breakdown-head">
                            <span>Pocket Breakdown</span>
                            <button type="button" class="transaction-breakdown-add" id="addPocketBtn" onclick="addBreakdownRow()">Add Pocket</button>
                        </div>
                        <div class="breakdown-container" id="breakdownRows"></div>
                        <div class="breakdown-total mt-4" id="breakdownTotalCard">
                            <div class="breakdown-total-row mb-2">
                                <span class="label">Allocated</span>
                                <span class="value" id="allocatedTotal">Rp 0</span>
                            </div>
                            <div class="breakdown-total-row mb-2">
                                <span class="label">Transaction Amount</span>
                                <span class="value" id="transactionAmountDisplay">Rp 0</span>
                            </div>
                            <div class="breakdown-total-row">
                                <span class="label">Difference</span>
                                <span class="value" id="differenceDisplay">Rp 0</span>
                            </div>
                            <div class="breakdown-progress">
                                <div class="breakdown-progress-fill" id="breakdownProgressFill" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <div id="singlePocketSection" style="display:none;"></div>

                    <div class="transaction-row relative" id="dateTrigger" style="position: relative; cursor: pointer;">
                        <span class="transaction-row-label">Date</span>
                        <span class="transaction-row-value" id="dateDisplay">25 Apr</span>
                        <input type="date" id="date" name="date" required style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.01; cursor: pointer; z-index: 10;">
                    </div>

                    {{#if salaryCycleBudgetingEnabled}}
                    <div class="transaction-budget-month" id="budgetMonthSection" data-salary-cycle-enabled="true">
                        <p class="transaction-budget-derived" aria-live="polite">Kamu memakai budget bulan <strong id="derivedBudgetMonth">…</strong></p>
                    </div>
                    {{else}}
                    <div class="transaction-budget-month" id="budgetMonthSection" data-salary-cycle-enabled="false">
                        <p class="transaction-field-label">Budget Month</p>
                        <div class="transaction-budget-options" id="budgetMonthOptions"></div>
                        <select id="budgetMonth" name="budgetMonth" required class="sr-only"></select>
                    </div>
                    {{/if}}
                    <p id="dateError" class="transaction-field-error" role="alert" aria-live="polite"></p>
                </section>

                <button type="submit" class="transaction-save-btn" id="submitBtn">Save Transaction</button>
                <button type="button" class="transaction-delete-btn" id="deleteBtn" hidden>Delete transaction</button>
            </div>

            <div class="transaction-hidden-types" aria-hidden="true">
                {{#each (split "Eat,Snack,Groceries,Laundry,Bensin,Flazz,Home Appliance,Jumat Berkah,Uang Sampah,Uang Keamanan,Medicine,Others")}}
                <input type="radio" name="type" value="{{this}}" class="option-input type-hidden-input" data-type-label="{{this}}" required>
                {{/each}}
            </div>
        </form>
    </div>

    <div class="picker-sheet-overlay" id="typeSheet">
        <div class="picker-sheet-card">
            <div class="picker-sheet-head">
                <h3>Expense Type</h3>
                <div class="flex items-center gap-3">
                    <a href="/expense-type-management" class="text-xs font-semibold"
                        style="color: var(--journal-accent, #6366f1);"
                        aria-label="Manage expense types">Manage Types</a>
                    <button type="button" class="picker-sheet-close" data-close-sheet="typeSheet">Close</button>
                </div>
            </div>
            <div class="picker-grid">
                {{#each (split "Eat,Snack,Groceries,Laundry,Bensin,Flazz,Home Appliance,Jumat Berkah,Uang Sampah,Uang Keamanan,Medicine,Others")}}
                <button type="button" class="picker-grid-item" data-type-option="{{this}}">
                    <span class="picker-grid-icon">{{getEmoji this}}</span>
                    <span>{{this}}</span>
                </button>
                {{/each}}
            </div>
        </div>
    </div>

    <div class="picker-sheet-overlay" id="pocketSheet">
        <div class="picker-sheet-card">
            <div class="picker-sheet-head">
                <h3>Pocket Source</h3>
                <div class="flex items-center gap-3">
                    <a href="/pocket-management" class="text-xs font-semibold"
                        style="color: var(--journal-accent, #6366f1);"
                        aria-label="Manage pockets and Budget Month setup">Manage Pockets</a>
                    <button type="button" class="picker-sheet-close" data-close-sheet="pocketSheet">Close</button>
                </div>
            </div>
            <!-- Populated exclusively by the assignment-backed pocket options
                 fetched in /js/log-spending.js. There is no server-rendered
                 fallback grid: showing one first and swapping it a moment
                 later is exactly the stale-then-correct flash this avoids. -->
            <div class="picker-grid" data-pocket-grid>
                <div class="col-span-full text-center py-4" data-pocket-loading>
                    <p class="text-sm" style="color: var(--journal-soft-ink, inherit);">Loading pockets…</p>
                </div>
            </div>
        </div>
    </div>

    <div id="deleteModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
        <div class="modal-card">
            <h3 id="deleteModalTitle">Delete this?</h3>
            <p id="deleteDetails" class="text-text-secondary mb-5"></p>
            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" id="deleteCancelBtn">Cancel</button>
                <button type="button" class="btn-modal-danger" id="deleteConfirmBtn">Delete</button>
            </div>
        </div>
    </div>

    <input type="hidden" id="salaryCycleEnabled" value="{{salaryCycleBudgetingEnabled}}">
    <input type="hidden" id="expenseTypeManagementEnabled" value="{{expenseTypeManagementEnabled}}">
    <div id="message" class="toast"></div>
    <script src="/js/common.js"></script>
    <script src="/js/banks.js"></script>
    <script src="/js/confetti.js"></script>
    <script src="/js/log-spending.js"></script>
</body>

</html>
