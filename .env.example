MONGODB_URI=mongodb://localhost:27017/moneyjournal
SESSION_SECRET=your_super_secret_key_here
PORT=3000
NODE_ENV=development

# Salary-cycle budgeting rollout configuration
HOUSEHOLD_TIME_ZONE=Asia/Jakarta
SALARY_CYCLE_BUDGETING_ENABLED=false

# Pocket Management rollout configuration (disabled by default). The primary
# flag gates managed pocket routes/reads; enable dual-write only after the
# primary flag is on during the migration compatibility window.
POCKET_MANAGEMENT_ENABLED=false
POCKET_MANAGEMENT_DUAL_WRITE=false
